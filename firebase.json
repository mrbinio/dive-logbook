{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".github",
      ".git",
      ".gitignore",
      "olld Json",
      "*.json",
      "!manifest.json",
      "firestore.rules",
      "functions/**",
      "functions",
      "**/.*",
      "**/.*/**",
      ".git/**",
      "**/__pycache__/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python313",
      "ignore": [
        "venv",
        ".git",
        "__pycache__",
        "*.local"
      ]
    }
  ]
}
