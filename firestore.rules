rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private per-user data: dives (+ photos subcollection), certs, gear
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public dive map: only site/GPS/date/depth/duration/rating, written by the owner
    match /publicMaps/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared trip checklists: members, and people invited by email
    match /trips/{tripId} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      allow read, update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || request.auth.token.email in resource.data.pendingInvites);
    }

    // Legacy shared collection, read once by the owner for migration
    match /dives/{id} {
      allow read: if request.auth != null
        && request.auth.token.email == 'damianbiniarz@gmail.com';
    }
  }
}
